# Flask Configuration
SECRET_KEY=change-this-to-a-super-secret-key-in-production
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Database Configuration (Defaults to SQLite for local ease, change to MySQL for production)
# Example MySQL URI: mysql+pymysql://root:password@localhost/school_db
DATABASE_URL=sqlite:///school.db

# Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB max limit
UPLOAD_FOLDER=app/static/uploads
